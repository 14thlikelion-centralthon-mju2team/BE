# 로컬/배포 환경변수 예시. 복사해서 .env로 저장하고 값을 채운다.
#   cp .env.example .env
# docker-compose가 같은 디렉토리의 .env를 자동으로 읽는다 (docker-compose.yml 참고).

### DB — 로컬 개발은 docker-compose의 postgres 서비스 기본값 그대로 쓰면 됨 ###
DB_HOST=localhost
DB_PORT=5432
DB_NAME=backend
DB_USER=backend
DB_PASSWORD=backend

### Google OAuth — 구글 로그인(POST /auth/google) + 캘린더 연동(offline 리프레시 토큰 발급용) ###
# Google Cloud Console(console.cloud.google.com) > APIs & Services > Credentials
# > Create Credentials > OAuth client ID > Web application 으로 발급.
# client-secret은 캘린더 refresh_token/authorization_code 교환에 쓰여서 Web application 타입이어야 함.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

### 공공데이터포털 — 기상청 단기예보 (KmaEnvironmentProvider) ###
# data.go.kr 로그인 후 "기상청_단기예보 ((구)_동네예보) 조회서비스" 페이지에서 활용신청.
# 승인 후 마이페이지 > 데이터활용 > Open API 에서 인증키(일반 인증키, Decoding) 복사.
DATA_GO_KR_SERVICE_KEY=

### JWT / 암호화 — 배포 전 반드시 아래 dev 기본값과 다른 값으로 교체 ###
JWT_SECRET=
ENCRYPTION_SECRET=
ENCRYPTION_SALT=

### ODsay — 서버 플랫폼 키 (고정 공인 IPv4 allowlist 등록 후 발급) ###
# 절대 Git에 실제 키를 기록하지 말고, 배포 서버의 .env에만 설정한다.
ODSAY_API_KEY=
# 선택값: 외부 API 연결/응답 제한 시간(ms)
ODSAY_CONNECT_TIMEOUT_MS=2000
ODSAY_READ_TIMEOUT_MS=3000

### 환경 Provider — AirKorea 실시간 측정소 + 기상청 생활기상 UV ###
# KMA 단기예보 key와 AirKorea key는 data.go.kr에서 각각 발급합니다. 실제 key는 절대 Git에 기록하지 않습니다.
AIRKOREA_SERVICE_KEY=
# 예: 종로구. 현재 deployment가 사용하는 실제 측정소 이름으로 설정합니다.
AIRKOREA_STATION_NAME=
# 예: 1100000000. 기상청 생활기상지수 API의 행정구역 코드로, 좌표에서 추론하지 않습니다.
KMA_UV_AREA_NO=
ENVIRONMENT_CONNECT_TIMEOUT_MS=2000
ENVIRONMENT_READ_TIMEOUT_MS=3000
